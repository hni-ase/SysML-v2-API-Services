# Copy to .env and adjust. Used by local runs / `docker run --env-file .env`.
# Docker Compose (e.g. a parent stack) can set the same variables on the service.

# Full JDBC URL (host, port, database name)
SYSML_JDBC_URL=jdbc:postgresql://localhost:5432/sysml2

# Database credentials
SYSML_JDBC_USER=postgres
SYSML_JDBC_PASSWORD=mysecretpassword

# Optional JVM options for the Play process
# JAVA_OPTS=-Xmx2G
